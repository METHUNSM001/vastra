# ==============================================================================
# VASTRA LAKSHNAM PRODUCTION ENVIRONMENT CONFIGURATION
# Set these in your Render.com Dashboard (Environment Variables section)
# ==============================================================================

# 1. BRAND & WHATSAPP SETTINGS
# Your 10-digit Dindigul store WhatsApp number with country code (e.g. 919488412345)
VITE_WHATSAPP_PHONE=919488412345

# 2. SUPABASE BACKEND CREDENTIALS (app.supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. RAZORPAY PAYMENT GATEWAY (dashboard.razorpay.com)
VITE_RAZORPAY_KEY_ID=rzp_live_YourLiveRazorpayKeyId

# 4. OPTIONAL: SHIPROCKET / LOGISTICS API (app.shiprocket.in)
VITE_SHIPROCKET_API_EMAIL=care@vastralakshnam.com
VITE_SHIPROCKET_API_PASSWORD=YourShiprocketPassword

# 5. OPTIONAL: TRANSACTIONAL SMS GATEWAY (fast2sms.com / msg91.com)
VITE_SMS_API_KEY=YourFast2SMSApiKeyHere
VITE_SMS_SENDER_ID=VASTRA
